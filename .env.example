# Copy this file to .env, then replace every CHANGE_ME value before deployment.
COMPOSE_PROJECT_NAME=pktmail
MAILU_VERSION=2024.06
MAILU_DATA_ROOT=./data

# Docker networking. Confirm that this subnet is unused on the VPS.
SUBNET=192.168.203.0/24
RESOLVER_IP=192.168.203.254
MAILU_NETWORK_NAME=pktmail_default

# Host publishing. Web ports stay local because the host reverse proxy owns 80/443.
BIND_ADDRESS4=88.96.39.248
MAILU_HTTP_PORT=8081
MAILU_HTTPS_PORT=8443

# Mailu identity.
SECRET_KEY=gBTIZwNHmYlHhDXJ
DOMAIN=pktm.fr
HOSTNAMES=mail.pktm.fr
POSTMASTER=postmaster
TLS_FLAVOR=cert
TZ=Europe/Paris

# Features.
ADMIN=true
API=true
WEBMAIL=roundcube
WEBDAV=none
ANTIVIRUS=none
SCAN_MACROS=true
FETCHMAIL_ENABLED=false
FULL_TEXT_SEARCH=en
FULL_TEXT_SEARCH_ATTACHMENTS=false

# Web routes.
WEBROOT_REDIRECT=/webmail
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
SITENAME=Mail pktm.fr
WEBSITE=https://pktm.fr

# The API token is a full-administration secret. Never commit the real value.
API_TOKEN=i3Fsn1QhGsAELfKidC6YyxqjALvhdEu7

# Mail and abuse controls.
MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day
RELAYNETS=
RELAYHOST=
RECIPIENT_DELIMITER=+
DMARC_RUA=postmaster
DMARC_RUF=postmaster
AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day
REJECT_UNLISTED_RECIPIENT=yes
DEFAULT_SPAM_THRESHOLD=80
CREDENTIAL_ROUNDS=12
LOG_LEVEL=INFO
DISABLE_STATISTICS=True

# The host reverse proxy connects through the gateway of SUBNET.
REAL_IP_HEADER=X-Forwarded-For
REAL_IP_FROM=192.168.203.1

# Optional one-time bootstrap. Prefer the documented CLI command instead of
# storing an administrator password here. Uncomment only for first startup.
# INITIAL_ADMIN_ACCOUNT=admin
# INITIAL_ADMIN_DOMAIN=pktm.fr
# INITIAL_ADMIN_PW=Azertu124509%
# INITIAL_ADMIN_MODE=ifmissing
