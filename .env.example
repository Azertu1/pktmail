# Optional Compose overrides; Portainer uses these defaults without a .env.
COMPOSE_PROJECT_NAME=pktmail
MAILU_VERSION=2024.06
MAILU_DATA_ROOT=/opt/pktmail/data
# Path inside Portainer, prepared by bootstrap-portainer.sh:
MAILU_SECRETS_FILE=/data/pktmail/secrets.env
BIND_ADDRESS4=0.0.0.0
MAILU_HTTP_PORT=8081
MAILU_HTTPS_PORT=8443
SUBNET=192.168.203.0/24
RESOLVER_IP=192.168.203.254
MAILU_NETWORK_NAME=pktmail_default
